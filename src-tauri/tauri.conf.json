{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shoko's LLM",
  "version": "0.1.0",
  "identifier": "dev.shoko.frontier",
  "build": { "beforeDevCommand": "pnpm dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "pnpm build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Shoko's LLM", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 640 }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost" } },
  "bundle": { "active": true, "targets": "all", "resources": ["../runtime-packs"] }
}
